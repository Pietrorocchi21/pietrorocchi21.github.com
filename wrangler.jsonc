{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pietro-rocchi-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pietro-portfolio-content",
    "migrations_dir": "migrations"
  }]
}
